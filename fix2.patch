+internal data class GuiApprovalEvidence(val labels: String, val password: Boolean, val known: Boolean)
+
+internal fun guiApprovalTargetIdentity(candidates: List<RootShellDeviceController.UiNode>): String {
+    fun identity(node: RootShellDeviceController.UiNode) =
+        "${node.viewId}:${node.className}:${if (node.password || node.editable) "" else node.text}:${node.desc}:${node.hint}"
+    // Labels break ties for repeated view IDs; neither bounds nor observation order is identity.
+    return candidates.sortedWith(compareBy<RootShellDeviceController.UiNode>(
+        { it.className }, { it.viewId }, ::identity,
+    )).joinToString("|", transform = ::identity).ifBlank { "untargeted" }
+}
+
+internal fun guiApprovalEvidence(
+    nodes: List<RootShellDeviceController.UiNode>,
+    candidates: List<RootShellDeviceController.UiNode>,
+): GuiApprovalEvidence {
+    // Container labels often live on descendants whose bounds do not cover the tapped point.
+    val descendants = nodes.filter { child ->
+        candidates.any { parent ->
+            parent.bounds.contains(child.bounds) &&
+                child.bounds.width().toLong() * child.bounds.height() <
+                parent.bounds.width().toLong() * parent.bounds.height()
+        }
+    }
+    val evidenceNodes = (candidates + descendants).distinct()
+    return GuiApprovalEvidence(
+        labels = evidenceNodes.joinToString(" ") { "${it.text} ${it.desc} ${it.hint} ${it.viewId}" },
+        password = evidenceNodes.any { it.password },
+        // No hit is a blank-area action; still let the policy check sensitive labels first.
+        known = candidates.isEmpty() || evidenceNodes.any {
+            it.password || it.text.isNotBlank() || it.desc.isNotBlank() || it.hint.isNotBlank()
+        },
+    )
+}
