+    /** Accumulate one finalized request; merge streaming snapshots before calling this. */
+    fun accumulateRequest(other: AgentTokenUsage, logger: AgentLogger): AgentTokenUsage {
+        val previousInput = inputTokens
+        val incomingCached = other.cachedTokens
+        val cumulativeSnapshot = previousInput != null && previousInput > 0 &&
+            incomingCached != null && incomingCached >= previousInput
+        if (cumulativeSnapshot) {
+            logger.warn(
+                "Token usage may be a provider cumulative snapshot: " +
+                    "cachedTokens=$incomingCached >= accumulatedInputTokens=$previousInput; " +
+                    "using max instead of sum for token counts",
+            )
+        }
+        fun tokens(a: Int?, b: Int?): Int? = when {
+            a == null -> b
+            b == null -> a
+            cumulativeSnapshot -> maxOf(a, b)
+            else -> a + b
+        }
+        fun millis(a: Long?, b: Long?): Long? =
+            if (a == null && b == null) null else (a ?: 0L) + (b ?: 0L)
+        return other.copy(
+            inputTokens = tokens(inputTokens, other.inputTokens),
+            outputTokens = tokens(outputTokens, other.outputTokens),
+            cachedTokens = tokens(cachedTokens, other.cachedTokens),
+            reasoningTokens = tokens(reasoningTokens, other.reasoningTokens),
+            requestDurationMs = millis(requestDurationMs, other.requestDurationMs),
+            // One unmeasured request makes the run's cumulative TTFT unknown thereafter.
+            firstTokenMs = if (other.firstTokenMs != null && (isEmpty || firstTokenMs != null)) {
+                millis(firstTokenMs, other.firstTokenMs)
+            } else null,
+            requestCount = if (requestCount == null && other.requestCount == null) null
+                else (requestCount ?: 0) + (other.requestCount ?: 0),
+            toolDurationMs = toolDurationMs,
+        )
+    }
+
     val isEmpty: Boolean
